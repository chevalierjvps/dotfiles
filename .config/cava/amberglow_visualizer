#  ⚡ AMBERGLOW CRT CAVA VISUALIZER ⚡
#  Retro phosphor amber gradient with monstercat audio smoothing & 60fps
# ══════════════════════════════════════════════════════════════════════════════

[general]
framerate = 60
autosens = 1
overshoot = 20
sensitivity = 100
bars = 0
bar_width = 2
bar_spacing = 1
lower_cutoff_freq = 40
higher_cutoff_freq = 16000

[input]
method = pipewire
source = auto

[output]
method = noncurses
style = stereo

[color]
background = 'default'
foreground = '#e8952d'

gradient = 1
gradient_count = 6
gradient_color_1 = '#6a5332'
gradient_color_2 = '#8a6c38'
gradient_color_3 = '#b88234'
gradient_color_4 = '#e8952d'
gradient_color_5 = '#f2a94a'
gradient_color_6 = '#ffbe60'

[smoothing]
monstercat = 1
waves = 0
noise_reduction = 60
