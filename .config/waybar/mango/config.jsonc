{
  "layer": "top",
  "position": "top",
  "height": 30,
  "margin-top": 0,
  "margin-left": 0,
  "margin-right": 0,
  "margin-bottom": 0,
  "spacing": 0,
  "modules-left": [
    "custom/launcher",
    "custom/pacman",
    "custom/tags",
    "custom/title"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "mpris",
    "custom/weather",
    "custom/cpu-temp",
    "network",
    "bluetooth",
    "pulseaudio",
    "custom/mic",
    "backlight",
    "battery",
    "tray",
    "idle_inhibitor",
    "custom/notifications",
    "custom/lock",
    "custom/power"
  ],
  "custom/launcher": {
    "format": "",
    "tooltip-format": "Applications (SUPER+D)",
    "on-click": "rofi -show drun"
  },
  "custom/tags": {
    "exec": "~/.config/waybar/mango/scripts/tags.sh",
    "return-type": "json",
    "on-scroll-up": "mmsg dispatch viewtoleft",
    "on-scroll-down": "mmsg dispatch viewtoright"
  },
  "custom/title": {
    "exec": "~/.config/waybar/mango/scripts/title.sh",
    "return-type": "json",
    "max-length": 60,
    "hide-empty-text": true
  },
  "mpris": {
    "format": " {title}",
    "format-playing": " {title}",
    "format-paused": " {title}",
    "max-length": 20,
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next",
    "on-click-middle": "playerctl previous",
    "on-scroll-up": "playerctl volume 0.05+",
    "on-scroll-down": "playerctl volume 0.05-",
    "tooltip-format": "{player} — {title}"
  },
  "clock": {
    "format": "{:%H:%M  ·  %a %d %b}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "on-click-right": "kitty -e cal -3"
  },
  "custom/pacman": {
    "exec": "~/.config/waybar/mango/scripts/pacman.sh",
    "return-type": "json",
    "on-click": "kitty -e sh -c 'sudo pacman -Syu && paru -Sua; rm -f ~/.cache/waybar-pacman-updates; echo; read -n1'"
  },
  "custom/weather": {
    "exec": "~/.config/waybar/mango/scripts/weather.sh",
    "return-type": "json",
    "interval": 1800,
    "on-click": "kitty -e sh -c 'curl -s wttr.in; read -n1'"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    },
    "tooltip-format-activated": "Idle inhibitor active",
    "tooltip-format-deactivated": "Idle inhibitor inactive"
  },
  "custom/cpu-temp": {
    "exec": "~/.config/waybar/mango/scripts/temp.sh",
    "return-type": "json",
    "interval": 5,
    "format": " {}",
    "on-click": "kitty -e btop"
  },
  "tray": {
    "icon-size": 16,
    "spacing": 8
  },
  "network": {
    "format-wifi": "{icon}  {signalStrength}%",
    "format-ethernet": "󰈀  100%",
    "format-disconnected": "󰤮  off",
    "format-disabled": "󰤮  off",
    "format-icons": [
      "󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "tooltip-format": "{ifname}: {ipaddr}/{cidr}",
    "tooltip-format-wifi": "{essid} ({signalStrength}%) · {ipaddr}",
    "tooltip-format-ethernet": "Wired ({ifname}) · {ipaddr}",
    "tooltip-format-disconnected": "Disconnected",
    "tooltip-format-disabled": "WiFi disabled",
    "on-click": "kitty --class nmtui-float -e nmtui",
    "on-click-right": "nmcli radio wifi toggle"
  },
  "bluetooth": {
    "format": " {status}",
    "format-connected": " {device_alias}",
    "format-disabled": " off",
    "on-click": "blueman-manager",
    "on-click-right": "bluetoothctl power toggle"
  },
  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "  mute",
    "format-icons": {
      "default": [
        "",
        "",
        ""
      ]
    },
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pavucontrol",
    "on-scroll-up": "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
  },
  "custom/mic": {
    "exec": "~/.config/waybar/mango/scripts/mic.sh",
    "return-type": "json",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "on-click-right": "pavucontrol",
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%-"
  },
  "backlight": {
    "format": "{icon}  {percent}%",
    "format-icons": [
      "󰃚",
      "󰃛",
      "󰃜",
      "󰃝",
      "󰃞",
      "󰃟",
      "󰃠"
    ],
    "on-scroll-up": "brightnessctl set +5%",
    "on-scroll-down": "brightnessctl set 5%-"
  },
  "battery": {
    "format": "{icon}  {capacity}%",
    "format-charging": "  {capacity}%",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    "states": {
      "warning": 20,
      "critical": 10
    },
    "tooltip-format": "{time} remaining · click: cycle power profile",
    "on-click": "~/.config/waybar/mango/scripts/cycle-power-profile.sh"
  },
  "custom/notifications": {
    "exec": "~/.config/waybar/mango/scripts/notifications.sh",
    "return-type": "json",
    "on-click": "rofi -show notif -modes notif:~/.config/rofi/scripts/notif_mode.sh -theme ~/.config/rofi/amberglow.rasi",
    "on-click-right": "makoctl mode -t do-not-disturb"
  },
  "custom/lock": {
    "format": "",
    "tooltip-format": "Lock screen (SUPER+L)",
    "on-click": "swaylock"
  },
  "custom/power": {
    "format": "",
    "tooltip-format": "Power menu",
    "on-click": "~/.config/rofi/scripts/powermenu.sh"
  }
}
