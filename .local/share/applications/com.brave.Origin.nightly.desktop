[Desktop Entry]
Version=1.0
Name=Brave Origin (nightly)
GenericName=Web Browser
Comment=Access the Internet
Exec=/usr/bin/brave-origin-nightly --load-extension=/home/jagermeister/.local/share/chrome-themes/amberglow-brave %U
StartupNotify=true
Terminal=false
Icon=brave-origin-nightly
Type=Application
Categories=Network;WebBrowser;
MimeType=text/html;text/xml;application/xhtml_xml;x-scheme-handler/http;x-scheme-handler/https;
StartupWMClass=brave-origin-nightly
Actions=new-window;new-private-window;

[Desktop Action new-window]
Name=New Window
Exec=/usr/bin/brave-origin-nightly --load-extension=/home/jagermeister/.local/share/chrome-themes/amberglow-brave

[Desktop Action new-private-window]
Name=New Incognito Window
Exec=/usr/bin/brave-origin-nightly --load-extension=/home/jagermeister/.local/share/chrome-themes/amberglow-brave --incognito
